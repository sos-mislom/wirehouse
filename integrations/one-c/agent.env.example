# Copy to .local/one-c-agent.env and restrict access to its Windows account.
# The bridge never loads the CRM server .env or bot/SSH credentials.
ONE_C_CRM_URL=https://crm.example.invalid
ONE_C_SOURCE_ID=
ONE_C_ENVIRONMENT=test
ONE_C_SOURCE_TOKEN=
ONE_C_DATABASE=
ONE_C_USER=
ONE_C_PASSWORD=
# Server mode: leave ONE_C_DATABASE empty; configure both values below.
# ONE_C_SERVER=one-c.internal:1541
# ONE_C_INFOBASE=Accounting
