{
  "name": "warehouse-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.6.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:desktop": "npm --workspace apps/desktop-windows run desktop:start",
    "dev:android": "npm --workspace apps/android run android:sync",
    "build:web": "npm --workspace apps/web run build",
    "desktop:dist:win": "npm --workspace apps/desktop-windows run desktop:dist:win",
    "desktop:release:win": "npm --workspace apps/desktop-windows run desktop:release:win",
    "android:release": "npm --workspace apps/android run android:release",
    "android:sync": "npm --workspace apps/android run android:sync",
    "backup:postgres": "node scripts/backup-postgres.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p packages/contracts/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test:browser": "node tests/browser.mjs",
    "check": "npm run typecheck && npm test && npm run build:web",
    "package:release": "node scripts/package-release.mjs"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "prettier": "3.9.8"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
